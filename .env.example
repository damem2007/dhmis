DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Database-backed tests must use the isolated local service started by
# scripts/run-integration-tests.sh. Do not point this at a shared environment.
DHMIS_TEST_DATABASE_URL=postgresql://dhmis_integration:dhmis_integration@127.0.0.1:54329/dhmis_integration
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_KEY=replace-with-a-random-bootstrap-key
DEMO_PASSWORD=replace-with-a-strong-demo-password
ENVIRONMENT=development
    STAFF_SESSION_TTL_SECONDS=28800
    STAFF_IDLE_TIMEOUT_SECONDS=3600
    # Roles & Access catalogue refresh cadence and complete modules per page.
    RBAC_CATALOGUE_CHECK_INTERVAL_SECONDS=60
    RBAC_CATALOGUE_MODULES_PER_PAGE=5
PLATFORM_PUBLIC_URL=http://localhost:5172
TENANT_ADMIN_PUBLIC_URL_TEMPLATE=http://admin.{tenant_slug}.dhmis.test:5175
CORS_ORIGINS=["http://localhost:5172","http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5172","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]
# Local development wrapping key. Production must use a managed KMS/HSM.
VAULT_KEY=base64-encoded-32-byte-key
KEY_PROVIDER=local
KEY_PROVIDER_VERSION=v1
KMS_KEY_ID=
KMS_REGION=
# AWS KMS (uses the AWS SDK default credential chain).
AWS_KMS_KEY_ID=
AWS_KMS_REGION=
# Google Cloud KMS (uses Application Default Credentials).
GCP_KMS_KEY_NAME=
# Azure Key Vault (uses DefaultAzureCredential).
AZURE_KEY_VAULT_KEY_URL=
# HashiCorp Vault Transit. Supply the token through the deployment secret store.
VAULT_TRANSIT_ADDR=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=
VAULT_TRANSIT_TOKEN=
VAULT_TRANSIT_NAMESPACE=
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_LIVE_INTEGRATIONS=false
PROVIDER_OPTIONS={"tomtom":{"api_key":"","language":"en-US","static_image_endpoint":"https://api.tomtom.com/map/1/staticimage","web_base_url":"https://www.tomtom.com/map/"},"openstreetmap":{"base_url":"https://www.openstreetmap.org","embed_base_url":"https://www.openstreetmap.org/export/embed.html"}}
DATABASE_ALIASES={}
