DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_KEY=replace-with-a-random-bootstrap-key
DEMO_PASSWORD=replace-with-a-strong-demo-password
ENVIRONMENT=development
PLATFORM_PUBLIC_URL=http://localhost:5172
TENANT_ADMIN_PUBLIC_URL_TEMPLATE=http://admin.{tenant_slug}.dhmis.local:5175
CORS_ORIGINS=["http://localhost:5172","http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5172","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]
VAULT_KEY=base64-encoded-32-byte-key
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_LIVE_INTEGRATIONS=false
PROVIDER_OPTIONS={"tomtom":{"api_key":"","language":"en-US","static_image_endpoint":"https://api.tomtom.com/map/1/staticimage","web_base_url":"https://www.tomtom.com/map/"},"openstreetmap":{"base_url":"https://www.openstreetmap.org","embed_base_url":"https://www.openstreetmap.org/export/embed.html"}}
DATABASE_ALIASES={}
