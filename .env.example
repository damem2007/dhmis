DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_KEY=replace-with-a-random-bootstrap-key
DEMO_PASSWORD=replace-with-a-strong-demo-password
ENVIRONMENT=development
PLATFORM_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VAULT_KEY=base64-encoded-32-byte-key
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_LIVE_INTEGRATIONS=false
PROVIDER_OPTIONS={}
DATABASE_ALIASES={}

